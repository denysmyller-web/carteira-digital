<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>br.com.ada</groupId><artifactId>carteira-digital</artifactId><version>1.0.0</version>
  <name>Carteira Digital</name>
  <properties><java.version>17</java.version><selenium.version>4.27.0</selenium.version></properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.seleniumhq.selenium</groupId><artifactId>selenium-java</artifactId><version>${selenium.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><excludedGroups>interface</excludedGroups></configuration></plugin>
    <plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.14</version><executions>
      <execution><goals><goal>prepare-agent</goal></goals></execution>
      <execution><id>relatorio</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
      <execution><id>cobertura-minima</id><phase>verify</phase><goals><goal>check</goal></goals><configuration><rules><rule>
        <element>CLASS</element><includes><include>br.com.ada.carteira.service.*</include><include>br.com.ada.carteira.controller.*</include></includes>
        <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit></limits>
      </rule></rules></configuration></execution>
    </executions></plugin>
  </plugins></build>
  <profiles><profile><id>selenium</id><build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><excludedGroups>nenhum</excludedGroups></configuration></plugin></plugins></build></profile></profiles>
</project>
